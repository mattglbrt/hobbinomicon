---
/**
 * ListCard Component
 * Horizontal card with thumbnail for list displays
 * Supports light and dark color schemes
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isImageMetadata } from '../utils/getHeroImage';

interface Props {
  href: string;
  image?: string | ImageMetadata | null;
  imageAlt?: string;
  title: string;
  description?: string;
  meta?: string;
  /**
   * Color scheme:
   * - 'light': Dark text on light background (default)
   * - 'dark': Light text on dark/transparent background
   */
  scheme?: 'light' | 'dark';
  /**
   * Thumbnail size at the horizontal (>=640px) breakpoint. Below that the
   * thumbnail is full-width regardless.
   * - 'sm': 192px wide
   * - 'md': 240px wide
   */
  size?: 'sm' | 'md';
  /**
   * Show left border accent
   */
  borderAccent?: boolean;
  class?: string;
}

const {
  href,
  image,
  imageAlt,
  title,
  description,
  meta,
  scheme = 'light',
  size = 'sm',
  borderAccent = false,
  class: className,
} = Astro.props;

// Thumbnail geometry.
//
// These are 16:9 video stills. Cropping them to a square threw away ~44% of
// the frame, which is most of what tells you what a vlog is about, so the box
// matches the source aspect and nothing is cut.
//
// Below 640px the card stacks and the image goes full-width: on a 390px screen
// a horizontal thumbnail big enough to read leaves the title nowhere to go.
const sizeClasses = {
  sm: 'w-full sm:w-48',
  md: 'w-full sm:w-48 md:w-60',
};

// Matches sizeClasses so the browser picks the right candidate.
const sizeAttr = {
  sm: '(min-width: 640px) 192px, 100vw',
  md: '(min-width: 768px) 240px, (min-width: 640px) 192px, 100vw',
};

// Color scheme classes
const schemeClasses = {
  // Every colour here needs its dark: counterpart. The palette inverts rather
  // than dimming — `ink` is near-black in light mode and cream in dark — so a
  // bare `text-ink` is the same near-black in both, which is invisible against
  // the dark background. That is exactly how this shipped.
  light: {
    wrapper: 'bg-ink/5 hover:bg-ink/10 dark:bg-ink-dark/5 dark:hover:bg-ink-dark/10',
    border: 'border-ink/30 hover:border-ink dark:border-ink-dark/30 dark:hover:border-ink-dark',
    title: 'text-ink dark:text-ink-dark',
    description: 'text-ink/80 dark:text-ink-dark/80',
    meta: 'text-ink/70 dark:text-ink-dark/70',
  },
  dark: {
    wrapper: 'bg-white/5 hover:bg-white/10',
    border: 'border-white/30 hover:border-white',
    title: 'text-white',
    description: 'text-white/70',
    meta: 'text-white/60',
  },
};

const colors = schemeClasses[scheme];
---

<a
  href={href}
  class:list={[
    'group flex flex-col sm:flex-row gap-3 sm:gap-4 p-3 sm:p-4 rounded-lg transition-all',
    colors.wrapper,
    borderAccent && `border-l-4 ${colors.border} rounded-l-none`,
    className,
  ]}
>
  {image && (
    <div class:list={['flex-shrink-0 overflow-hidden rounded-lg aspect-video', sizeClasses[size]]}>
      {isImageMetadata(image) ? (
        <Image
          src={image}
          alt={imageAlt || title}
          class="w-full h-full object-cover img-hover"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={60}
          width={480}
          height={270}
          widths={[192, 384, 480, 720]}
          sizes={sizeAttr[size]}
        />
      ) : (
        <img
          src={image}
          alt={imageAlt || title}
          class="w-full h-full object-cover img-hover"
          loading="lazy"
          decoding="async"
          width="480"
          height="270"
        />
      )}
    </div>
  )}
  <div class="flex-grow min-w-0 flex flex-col justify-center">
    {meta && (
      <span class:list={['text-sm mb-1', colors.meta]}>
        {meta}
      </span>
    )}
    <h3 class:list={[
      'text-lg md:text-xl font-heading font-bold group-hover:underline underline-offset-2',
      description ? 'line-clamp-2' : '',
      colors.title,
    ]}>
      {title}
    </h3>
    {description && (
      <p class:list={['text-sm mt-1 line-clamp-2', colors.description]}>
        {description}
      </p>
    )}
    <slot />
  </div>
</a>
