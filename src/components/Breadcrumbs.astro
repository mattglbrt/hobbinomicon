---
export interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  /**
   * 'dark' is the original: white text for the dark PageHeader band.
   * 'light' is for pages that put breadcrumbs straight onto parchment —
   * guides and the on-ramp hubs, which have no dark header to sit in.
   */
  scheme?: 'dark' | 'light';
}

const { items, scheme = 'dark' } = Astro.props;

const muted = scheme === 'dark' ? 'text-white/60' : 'text-ink/65 dark:text-ink-dark/65';
const hover = scheme === 'dark' ? 'hover:text-white' : 'hover:text-ink dark:hover:text-ink-dark';
const current = scheme === 'dark' ? 'text-white' : 'text-ink dark:text-ink-dark';
---

<nav aria-label="Breadcrumb" class="mb-6" data-pagefind-ignore>
  <ol class="flex items-center gap-2 text-sm font-mono">
    <li>
      <a
        href="/"
        class={`${muted} ${hover} transition-colors flex items-center gap-1`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Home</span>
      </a>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <>
          <li class={muted} aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li>
            {isLast ? (
              <span class={`${current} font-semibold`} aria-current="page">
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class={`${muted} ${hover} transition-colors`}
              >
                {item.label}
              </a>
            )}
          </li>
        </>
      );
    })}
  </ol>
</nav>
