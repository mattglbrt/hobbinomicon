---
// Lazy YouTube facade: renders only a thumbnail + play button, and swaps in
// the real iframe on click. Keeps pages fast (no YouTube JS/iframe until the
// visitor chooses to watch).
//
// Prefer the same-origin cached thumbnail (yt-<id>.jpg, downloaded by the
// prebuild) so we serve an optimized same-origin WebP instead of a remote
// i.ytimg.com image. Falls back to the YouTube thumbnail when uncached.
import { Image } from 'astro:assets';
import { getHeroImage, isImageMetadata } from '../utils/getHeroImage';

interface Props {
  videoId: string;
  title?: string;
}

const { videoId, title = 'YouTube video' } = Astro.props;
const cached = getHeroImage(undefined, videoId);
const thumbImage = isImageMetadata(cached) ? cached : null;
const thumbUrl = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div class="lite-yt group relative w-full overflow-hidden rounded-lg shadow-lg" style="aspect-ratio: 16 / 9;">
  <button
    type="button"
    class="lite-yt-trigger absolute inset-0 h-full w-full cursor-pointer"
    data-video-id={videoId}
    aria-label={`Play video: ${title}`}
  >
    {thumbImage ? (
      <Image
        src={thumbImage}
        alt={title}
        loading="lazy"
        decoding="async"
        format="webp"
        quality={60}
        width={640}
        height={360}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <img
        src={thumbUrl}
        alt={title}
        loading="lazy"
        decoding="async"
        width="480"
        height="270"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    )}
    <span class="absolute inset-0 bg-black/10 transition-colors group-hover:bg-black/25"></span>
    <span
      class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 transition-transform duration-300 group-hover:scale-110"
    >
      <svg class="ml-1 h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </button>
</div>

{/*
  No script here on purpose. This component renders inside #swup, and Swup
  swaps that container's contents in as parsed markup — scripts arriving that
  way never execute. A component-local handler would therefore be dead on
  every page reached by client-side navigation. The click handler is delegated
  from document in BaseLayout, outside the container, where it survives swaps.
*/}
