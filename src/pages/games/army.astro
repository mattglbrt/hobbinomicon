---
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory } from '../../utils/facets';

const entries = (await getDirectory()).filter(({ game }) => game.data.format === 'army');
---

<DirectoryPage
  title="Army-Scale Games"
  heading="Army-Scale Games"
  description="Games where you field a whole army. Bigger model counts, longer setup, and a table that takes a while to fill."
  path="/games/army/"
  crumb="Army"
  entries={entries}
  hideFacets={['type']}
></DirectoryPage>
