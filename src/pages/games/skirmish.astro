---
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory } from '../../utils/facets';

const entries = (await getDirectory()).filter(({ game }) => game.data.format === 'skirmish');
---

<DirectoryPage
  title="Skirmish Games"
  heading="Skirmish Games"
  description="Small-warband miniature games. Usually 5 to 15 models a side, narrative-friendly, low buy-in."
  path="/games/skirmish/"
  crumb="Skirmish"
  entries={entries}
  hideFacets={['type']}
></DirectoryPage>
