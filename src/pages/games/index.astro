---
/**
 * /games/ — the whole directory, filterable. Used to be a sampler of six
 * games per format, which hid most of the directory from its own front door.
 * The format and cross-listing pages still exist (and are linked below) as
 * the indexable landing pages for "skirmish games", "solo wargames" etc.
 */
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory, SETTING_PAGES, facetLabel } from '../../utils/facets';

const entries = await getDirectory();

const shelves = [
  { href: '/games/skirmish/', label: 'Skirmish' },
  { href: '/games/army/', label: 'Army-scale' },
  { href: '/games/narrative/', label: 'Narrative' },
  { href: '/games/solo/', label: 'Solo' },
  { href: '/games/chessboard/', label: 'Chessboard' },
  { href: '/games/free-rules/', label: 'Free rules' },
  { href: '/games/mini-agnostic/', label: 'Mini-agnostic' },
  ...SETTING_PAGES.map((s) => ({ href: `/games/setting/${s}/`, label: facetLabel('setting', s) })),
  { href: '/games/graveyard/', label: 'The Graveyard' },
];
---

<DirectoryPage
  title="Games"
  heading="Games"
  description={`Every game in the directory, ${entries.length} of them. Indie wargames, specialist games, out-of-print classics. Filter by players, price, minis and setting.`}
  path="/games/"
  entries={entries}
>
  <nav aria-label="Browse by" class="mb-10 flex gap-2 overflow-x-auto pb-2 -mx-6 px-6 snap-x lg:flex-wrap lg:overflow-visible lg:mx-0 lg:px-0">
    {shelves.map((s) => (
      <a href={s.href} class="snap-start shrink-0 inline-flex items-center min-h-11 px-4 rounded-full border border-ink/25 dark:border-ink-dark/25 text-ink dark:text-ink-dark text-sm font-medium hover:bg-ink/5 dark:hover:bg-ink-dark/10">
        {s.label}
      </a>
    ))}
  </nav>
</DirectoryPage>
