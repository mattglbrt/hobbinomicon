---
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory } from '../../utils/facets';

const entries = (await getDirectory()).filter(({ game }) => game.data.chessboard);
---

<DirectoryPage
  title="Games You Can Play on a Chessboard"
  heading="Games You Can Play on a Chessboard"
  description="Miniature games designed for a standard 8×8 chessboard. No terrain to build and no mat to buy, just the board you probably already own and some minis."
  path="/games/chessboard/"
  crumb="Chessboard"
  entries={entries}
></DirectoryPage>
