---
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory } from '../../utils/facets';

const entries = (await getDirectory()).filter(({ game }) => game.data.format === 'ttrpg');
---

<DirectoryPage
  title="TTRPGs"
  heading="TTRPGs"
  description="Kal Arath is the one RPG in the directory. Everything else RPG lives on Alone in the Dungeon."
  path="/games/ttrpgs/"
  crumb="TTRPGs"
  entries={entries}
>
  <p slot="after" class="mt-12 max-w-2xl text-lg text-ink/80 dark:text-ink-dark/80">
    Looking for Shadowdark, OSE, Mörk Borg or solo RPGs? They're on my RPG site,{' '}
    <a href="https://aloneinthedungeon.com/" class="text-ink dark:text-ink-dark font-medium underline underline-offset-4 hover:no-underline">Alone in the Dungeon</a>.
  </p>
</DirectoryPage>
