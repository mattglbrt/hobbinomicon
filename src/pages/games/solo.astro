---
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory } from '../../utils/facets';

const entries = (await getDirectory()).filter(({ facets }) => facets.players.includes('solo'));
---

<DirectoryPage
  title="Solo-Friendly Games"
  heading="Solo-Friendly Games"
  description="Games on the site that work without an opponent. Official solo rules, solo modes, and games designed for one."
  path="/games/solo/"
  crumb="Solo"
  entries={entries}
></DirectoryPage>
