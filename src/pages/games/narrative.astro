---
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory } from '../../utils/facets';

const entries = (await getDirectory()).filter(({ game }) => game.data.format === 'narrative');
---

<DirectoryPage
  title="Narrative Games"
  heading="Narrative Games"
  description="Story and scenario-driven miniature games. Often solo or co-op, often niche, often the most interesting corner of the hobby."
  path="/games/narrative/"
  crumb="Narrative"
  entries={entries}
  hideFacets={['type']}
></DirectoryPage>
