---
import DirectoryPage from '../../components/DirectoryPage.astro';
import { getDirectory } from '../../utils/facets';

const entries = (await getDirectory()).filter(({ game }) => game.data.status === 'oop');
---

<DirectoryPage
  title="The Graveyard"
  heading="The Graveyard"
  description="Officially out of print. Still on the table somewhere. The community has kept these dead games alive."
  path="/games/graveyard/"
  crumb="The Graveyard"
  entries={entries}
></DirectoryPage>
