---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentContainer from '../../components/ContentContainer.astro';
import ListCard from '../../components/ListCard.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getArticles } from '../../utils/content';
import { getHeroImageUrl } from '../../utils/getHeroImage';
import { formatDateLong } from '../../utils/formatDate';

const articles = await getArticles();
const description =
  'Lists, essays and reference pages. The things that are neither a painting guide nor a day at the desk.';
---

<BaseLayout title="Articles | The Hobbinomicon" description={description}>
  <StructuredData
    type="breadcrumb"
    data={{
      breadcrumbs: [
        { name: 'Home', url: 'https://hobbinomicon.com/' },
        { name: 'Articles', url: 'https://hobbinomicon.com/articles/' },
      ],
    }}
  />
  <Header theme="light" />

  <main id="main-content" class="min-h-screen bg-parchment dark:bg-parchment-dark">
    <PageHeader
      title="Articles"
      description={description}
      breadcrumbs={[{ label: 'Articles', href: '/articles' }]}
    />

    <ContentContainer class="py-16">
      <div class="grid gap-4">
        {articles.map((a) => (
          <ListCard
            href={`/articles/${a.id}/`}
            title={a.data.title}
            description={a.data.description}
            meta={formatDateLong(a.data.pubDate)}
            image={getHeroImageUrl(a.data.heroImage, a.data.youtubeId)}
          />
        ))}
      </div>
    </ContentContainer>

    <Footer />
  </main>
</BaseLayout>
