---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import DirectoryHero from '../components/DirectoryHero.astro';
import ListCard from '../components/ListCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Footer from '../components/Footer.astro';
import ContentContainer from '../components/ContentContainer.astro';
import ImageCard from '../components/ImageCard.astro';
import ViewAllLink from '../components/ViewAllLink.astro';
import { getHeroImage, getHeroImageUrl } from '../utils/getHeroImage';
import { sortByDate } from '../utils/collections';
import { getGuides, guideUrlWith, TOPICS, type Topic } from '../utils/content';

// ─── Directory: featured / recently added games ─────────────────────
const allGames = await getCollection('games', ({ data }) => !data.draft);
const featuredGames = [...allGames]
  .sort((a, b) => {
    // Indie tier first, then by most recently updated/published
    if (a.data.tier !== b.data.tier) return a.data.tier === 'indie' ? -1 : 1;
    const aDate = (a.data.updatedDate || a.data.pubDate).valueOf();
    const bDate = (b.data.updatedDate || b.data.pubDate).valueOf();
    return bDate - aDate;
  })
  .slice(0, 6);

// ─── Latest indie news ──────────────────────────────────────────────
const allNews = await getCollection('news', ({ data }) => !data.draft);
const recentNews = sortByDate(allNews).slice(0, 6);

// Resolve the related-game (if any) for each news item so news cards can fall
// back to the game's hero image.
const recentNewsCards = await Promise.all(
  recentNews.map(async (item) => {
    const game = item.data.relatedGame ? await getEntry(item.data.relatedGame) : null;
    const cardImageString = item.data.heroImage || game?.data.heroImage;
    const cardImage = cardImageString ? getHeroImage(cardImageString) : null;
    return { item, cardImage };
  })
);

// ─── Learn to paint: the newest guides ──────────────────────────────
const gameSlugs = new Set(allGames.map((g) => g.id));
const latestGuides = (await getGuides()).slice(0, 6);

// ─── On-ramp hubs. A hub only appears once it has guides behind it;
// an empty on-ramp is worse than no on-ramp.
const allGuides = await getGuides();
const hubs = [
  {
    slug: 'warmachine',
    name: 'Warmachine',
    blurb: 'Hobby and painting guides dedicated to Warmachine.',
  },
  {
    slug: 'warhammer',
    name: 'Warhammer',
    blurb: '40k, The Old World, and Spearhead. I do occasionally paint Games Workshop stuff still.',
  },
]
  .map((h) => ({ ...h, count: allGuides.filter((g) => g.data.hub === h.slug).length }))
  .filter((h) => h.count >= 3);
---

<BaseLayout
  title="The Hobbinomicon — find, play, and paint indie wargames"
  description="A directory of small and indie tabletop wargames, and the guides to get them on your table. Skirmish, army-scale, solo, and the weird stuff in between."
>
  <Header theme="dark" />

  <main id="main-content" class="min-h-screen">
    <!-- 1. Hero — directory value proposition + search -->
    <DirectoryHero />

    <!-- 2. Featured / recently added games -->
    {featuredGames.length > 0 && (
      <section class="bg-parchment dark:bg-parchment-dark py-16 md:py-24" data-scroll-reveal>
        <ContentContainer>
          <div class="section-head flex items-center justify-between mb-12">
            <div>
              <span class="block text-sm font-heading uppercase tracking-[0.3em] text-ink/65 dark:text-ink-dark/65 mb-2">Worth a closer look</span>
              <h2 class="text-5xl md:text-7xl font-display font-bold text-ink dark:text-ink-dark">Games worth knowing about</h2>
            </div>
            <ViewAllLink href="/games/">All Games →</ViewAllLink>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {featuredGames.map((game) => {
              const cardImage = game.data.thumbnailImage || game.data.heroImage;
              const resolvedImage = cardImage ? getHeroImage(cardImage) : null;
              const resolvedLogo = game.data.logo ? getHeroImage(game.data.logo) : null;
              const cardAlt = game.data.thumbnailImageAlt || game.data.heroImageAlt || game.data.title;
              return (
                <ImageCard
                  href={`/games/${game.id}/`}
                  image={resolvedImage}
                  imageAlt={cardAlt}
                  title={game.data.title}
                  subtitle={game.data.description}
                  logoOverlay={resolvedLogo}
                  fallbackLetter={game.data.title.charAt(0)}
                  aspectRatio="16/9"
                  variant="overlay"
                  subtitleOnHover
                  titleBelow
                />
              );
            })}
          </div>
        </ContentContainer>
      </section>
    )}

    <!-- 3. Latest indie news -->
    {recentNews.length > 0 && (
      <section class="bg-ink/[0.03] dark:bg-ink-dark/[0.03] py-16 md:py-24" data-scroll-reveal>
        <ContentContainer>
          <div class="section-head flex items-center justify-between mb-12">
            <div>
              <span class="block text-sm font-heading uppercase tracking-[0.3em] text-ink/65 dark:text-ink-dark/65 mb-2">What's new</span>
              <h2 class="text-5xl md:text-7xl font-display font-bold text-ink dark:text-ink-dark">News from the indie wargame world</h2>
            </div>
            <ViewAllLink href="/news/">All News →</ViewAllLink>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {recentNewsCards.map(({ item, cardImage }) => (
              <ImageCard
                href={`/news/${item.id}/`}
                image={cardImage}
                imageAlt={item.data.heroImageAlt || item.data.title}
                title={item.data.title}
                subtitle={item.data.description}
                fallbackLetter={item.data.title.charAt(0)}
                aspectRatio="16/9"
                variant="stacked"
              />
            ))}
          </div>
        </ContentContainer>
      </section>
    )}

    <!-- 4. Learn to paint — the other half of the promise in the hero -->
    {latestGuides.length > 0 && (
      <section class="bg-parchment dark:bg-parchment-dark py-16 md:py-24" data-scroll-reveal>
        <ContentContainer>
          <div class="section-head flex items-center justify-between mb-12">
            <div>
              <span class="block text-sm font-heading uppercase tracking-[0.3em] text-ink/65 dark:text-ink-dark/65 mb-2">Learn to paint and play it</span>
              <h2 class="text-5xl md:text-7xl font-display font-bold text-ink dark:text-ink-dark">Guides</h2>
            </div>
            <ViewAllLink href="/guides/">All Guides →</ViewAllLink>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {latestGuides.map((g) => (
              <ListCard
                href={guideUrlWith(g, gameSlugs)}
                title={g.data.title}
                description={g.data.description}
                meta={TOPICS[g.data.topic as Topic]}
                image={getHeroImageUrl(g.data.heroImage, g.data.youtubeId)}
              />
            ))}
          </div>
        </ContentContainer>
      </section>
    )}

    <!-- 5. On-ramps. These are the top of the funnel, not the destination:
         both hubs exist to point sideways into the indie directory. -->
    {hubs.length > 0 && (
      <section id="on-ramps" class="bg-ink dark:bg-ink-dark py-16 md:py-24 scroll-mt-24" data-scroll-reveal>
        <ContentContainer>
          <span class="block text-sm font-heading uppercase tracking-[0.3em] text-parchment/65 dark:text-parchment-dark/65 mb-2">Competitive Games</span>
          <h2 class="text-2xl md:text-4xl font-display font-bold text-parchment dark:text-parchment-dark mb-10 max-w-3xl leading-tight">Warmachine is my competitive game of choice, but I just can't give up on Warhammer.</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {hubs.map((h) => (
              <a
                href={`/${h.slug}/`}
                class="block p-8 rounded-lg border border-white/15 hover:border-white/40 hover:bg-white/5 transition-colors"
              >
                <span class="block font-display text-3xl font-bold text-parchment dark:text-parchment-dark">{h.name}</span>
                <span class="block mt-3 text-parchment/70 dark:text-parchment-dark/70 font-serif">{h.blurb}</span>
                <span class="block mt-4 text-sm font-heading uppercase tracking-[0.2em] text-parchment/65 dark:text-parchment-dark/65">
                  {h.count} guides →
                </span>
              </a>
            ))}
          </div>
        </ContentContainer>
      </section>
    )}

    <!-- 5. Newsletter — From the Workbench -->
    <div id="newsletter" class="scroll-mt-24">
      <NewsletterSignup variant="section" />
    </div>

    <Footer />
  </main>
</BaseLayout>
