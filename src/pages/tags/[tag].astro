---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ListCard from '../../components/ListCard.astro';
import Footer from '../../components/Footer.astro';
import StructuredData from '../../components/StructuredData.astro';
import ContentContainer from '../../components/ContentContainer.astro';
import { groupTaggedItems } from '../../utils/content';
import { getHeroImage, getHeroImageUrl } from '../../utils/getHeroImage';
import { formatDateLong } from '../../utils/formatDate';
import { getTagDisplay, getTagDescription } from '../../utils/tags';

export async function getStaticPaths() {
  // Tags span guides and the vlog archive alike; a tag page that showed only
  // one of them would hide half of what carries the tag.
  const tagsMap = await groupTaggedItems();
  return Array.from(tagsMap.entries()).map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
const guideCount = posts.filter((p) => p.kind === 'Guide').length;

// Get tag display name and description
const tagDisplay = getTagDisplay(tag);
const tagDescription = getTagDescription(tag);

// Social image from the first post
const socialImage = posts[0] ? getHeroImageUrl(posts[0].heroImage, posts[0].youtubeId) : undefined;
---

<BaseLayout title={`${tagDisplay} | The Hobbinomicon`} description={tagDescription} image={socialImage}>
  <StructuredData
    type="breadcrumb"
    data={{
      breadcrumbs: [
        { name: 'Home', url: 'https://hobbinomicon.com/' },
        { name: 'Tags', url: 'https://hobbinomicon.com/tags/' },
        { name: tagDisplay, url: `https://hobbinomicon.com/tags/${tag}/` },
      ],
    }}
  />
  <Header theme="light" />

  <main id="main-content" class="min-h-screen bg-parchment dark:bg-parchment-dark">
    <header class="bg-ink dark:bg-ink-dark text-parchment dark:text-parchment-dark pt-36 md:pt-40 pb-16">
      <ContentContainer>
        <a href="/tags/" class="inline-block text-parchment/80 hover:text-parchment dark:text-parchment-dark/80 dark:hover:text-parchment-dark mb-4 transition-colors">
          ← All Tags
        </a>
        <h1 class="text-5xl md:text-6xl font-heading font-bold">#{tagDisplay}</h1>
        {tagDescription && (
          <p class="text-xl text-parchment/90 dark:text-parchment-dark/90 mt-4 max-w-2xl">{tagDescription}</p>
        )}
        <p class="text-lg text-parchment/70 dark:text-parchment-dark/70 mt-2">
          {posts.length} {posts.length === 1 ? 'page' : 'pages'}{guideCount > 0 ? `, ${guideCount} of them ${guideCount === 1 ? 'a guide' : 'guides'}` : ''}
        </p>
      </ContentContainer>
    </header>

    <ContentContainer class="py-16">
      <div class="grid gap-4">
        {posts.map((post) => (
          <ListCard
            href={post.href}
            title={post.title}
            description={post.description}
            meta={`${post.kind} · ${formatDateLong(post.pubDate)}`}
            image={getHeroImage(post.heroImage, post.youtubeId)}
          />
        ))}
      </div>
    </ContentContainer>

    <Footer />
  </main>
</BaseLayout>
