---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentContainer from '../../components/ContentContainer.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import Footer from '../../components/Footer.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getVlogs } from '../../utils/content';

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getVlogs(), { pageSize: 24 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const description =
  'The daily hobby vlog, all of it. Painting sessions, mail days, false starts and the odd finished model.';
---

<BaseLayout
  title={page.currentPage === 1
    ? 'Vlog Archive | The Hobbinomicon'
    : `Vlog Archive | Page ${page.currentPage} | The Hobbinomicon`}
  description={description}
>
  <StructuredData
    type="breadcrumb"
    data={{
      breadcrumbs: [
        { name: 'Home', url: 'https://hobbinomicon.com/' },
        { name: 'Vlog', url: 'https://hobbinomicon.com/vlog/' },
      ],
    }}
  />
  <Header theme="light" />

  <main id="main-content" class="min-h-screen bg-parchment dark:bg-parchment-dark">
    <PageHeader
      title="Vlog Archive"
      description={page.currentPage === 1
        ? description
        : `Page ${page.currentPage} of ${page.lastPage}`}
      breadcrumbs={[{ label: 'Vlog', href: '/vlog' }]}
    />

    <ContentContainer class="py-16">
      <p class="text-ink/70 dark:text-ink-dark/70 text-sm mb-8">
        Showing {page.start + 1}–{page.end + 1} of {page.total} vlogs.
        Looking for a how-to? Those live in <a href="/guides/" class="underline underline-offset-2">the guides</a>.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {page.data.map((post) => <PostCard post={post} />)}
      </div>

      <Pagination
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        baseUrl="/vlog"
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
      />
    </ContentContainer>

    <Footer />
  </main>
</BaseLayout>
